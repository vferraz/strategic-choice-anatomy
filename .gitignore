# --------------------------------------------------------------------------
# Heavy released data — fetched by scripts/download_data.py, never tracked.
# --------------------------------------------------------------------------
data_heavy/

# Deposit staging area. Assembled on the collection machine (Phase 6) and uploaded to
# Zenodo (Phase 7); the tracked copies of anything small enough to ship live under data/.
_deposit/

# --------------------------------------------------------------------------
# Third-party raw human data. NEVER tracked: it belongs to the source studies
# and is not ours to redistribute. Developers typically symlink the two
# subdirectories at their own copies, which would otherwise put absolute local
# paths into public history. Only the placement instructions are tracked.
# --------------------------------------------------------------------------
data/human_refs/raw/*
!data/human_refs/raw/README.md

# --------------------------------------------------------------------------
# Figures: local rebuilds are ignored; the committed reference renders are not.
# --------------------------------------------------------------------------
**/figures/*.pdf
**/figures/*.png
!data/results/figures_reference/**

# Per-panel intermediates a figure script drops beside its output. Regenerated on
# every rebuild, and panelD_beeswarm.csv (10.5 MB) is a byte-identical duplicate of
# data/results/layer_a/s_shap_beeswarm.csv, which IS tracked.
**/figures/_*panel_data/

# --------------------------------------------------------------------------
# Binary data artifacts. Everything tracked lives under data/.
# (Negations must follow their ignore rule, and data/ itself is never ignored —
#  git does not descend into an ignored directory.)
# --------------------------------------------------------------------------
*.npz
*.npy
*.parquet
!data/**/*.npz
!data/**/*.npy
!data/**/*.parquet

# --------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --------------------------------------------------------------------------
# Secrets and OS cruft
# --------------------------------------------------------------------------
.env
.env.*
.DS_Store
Thumbs.db
